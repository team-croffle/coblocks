{
  "compilerOptions": {
    // ESM + Node.js 환경에 맞는 모듈 시스템 (package.json의 "exports" 필드를 올바르게 추적)
    "module": "nodenext",
    "moduleResolution": "nodenext",
    // 패키지의 package.json "exports" 필드를 존중하여 타입 해석 (drizzle-kit 등 외부 패키지 타입 오류 방지)
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    // 각 파일을 독립 모듈로 처리 (transpile-only 빌드와의 호환성 보장)
    "isolatedModules": true,

    // 컴파일 출력 설정
    "declaration": true,
    "removeComments": true,
    "allowSyntheticDefaultImports": true,
    "target": "esnext",
    "sourceMap": true,
    "incremental": true,

    // 타입 검사 설정
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false,

    // NestJS 데코레이터 지원
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,

    // 전역 타입 및 경로 별칭
    "types": ["node", "jest"],
    "outDir": "./dist",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  // drizzle.config.ts를 명시적으로 포함하여 drizzle-kit CLI가 타입 체크 가능하도록 설정
  "include": ["src/**/*", "drizzle.config.ts"],
  "exclude": ["node_modules", "dist"]
}
