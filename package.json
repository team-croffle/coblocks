{
  "name": "coblocks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:web": "pnpm --filter @coblocks/web dev",
    "dev:api": "pnpm --filter @coblocks/api start:dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check": "pnpm lint && pnpm fmt:check && pnpm typecheck",
    "db:up": "docker compose -f docker/docker-compose.dev.yaml up -d db",
    "db:push": "pnpm --filter @coblocks/api db:push",
    "db:seed": "pnpm --filter @coblocks/api db:seed",
    "prepare": "husky || echo 'husky 없음 — git hook 설치를 건너뜁니다 (--prod / CI 설치)'",
    "db:down": "docker compose -f docker/docker-compose.dev.yaml down",
    "docker:build": "docker build -f apps/api/Dockerfile -t coblocks-api:dev . && docker build -f apps/web/Dockerfile -t coblocks-web:dev ."
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.2.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "typescript": "6.0.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "*.json": [
      "oxfmt"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.25.0"
}
